<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="cocarPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>com.poo.javafx.tipo.CNPJConverter</class>
        <class>com.poo.javafx.tipo.CPFConverter</class>
        <class>com.poo.javafx.tipo.PlacaConverter</class>
        <class>com.poo.javafx.carona.estado.EstadoCaronaConverter</class>

        <class>com.poo.javafx.passageiro.PassageiroModel</class>
        <class>com.poo.javafx.carona.CaronaModel</class>
        <class>com.poo.javafx.veiculo.VeiculoModel</class>
        <class>com.poo.javafx.empresa.EmpresaModel</class>
        <class>com.poo.javafx.carteira.CarteiraModel</class>
        <class>com.poo.javafx.trajeto.TrajetoModel</class>
        <class>com.poo.javafx.transacao.TransacaoModel</class>
        <class>com.poo.javafx.beneficio.BeneficioModel</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/cocar"/>
            <property name="jakarta.persistence.jdbc.user" value="cocar"/>
            <property name="jakarta.persistence.jdbc.password" value="cocar"/>

            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
        </properties>
    </persistence-unit>
</persistence>
